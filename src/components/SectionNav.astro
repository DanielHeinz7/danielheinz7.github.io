---
const sections = [
  { label: 'Research', href: '/research/' },
  { label: 'Lab', href: '/lab/' },
  { label: 'Tools', href: '/tools/' },
  { label: 'Teaching', href: '/teaching/' },
  { label: 'Ideas', href: '/ideas/' },
  { label: 'At a glance', href: '/at-a-glance/' },
];
const path = Astro.url.pathname;
---
<nav class="section-nav" aria-label="Site sections">
  {sections.map(({ label, href }) => (
    <a href={href} aria-current={path === href ? 'page' : path.startsWith(href) || (href === '/at-a-glance/' && path === '/cv/') ? 'location' : undefined}>{label}</a>
  ))}
</nav>

<style>
  .section-nav { display: flex; flex-wrap: wrap; gap: 0 20px; border-bottom: 1px solid var(--rule); margin-bottom: 28px; padding-bottom: 8px; }
  .section-nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: 16px; font-weight: 700; text-decoration: none; color: var(--mute); }
  .section-nav a:hover, .section-nav a[aria-current] { color: var(--ink); text-decoration: underline; text-decoration-thickness: 2px; }
  @media (max-width: 850px) { .section-nav { column-gap: 20px; margin-bottom: 24px; } }
  @media print { .section-nav { display: none; } }
</style>
