---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Arrow from '../../components/Arrow.astro';
import PaperImage from '../../components/PaperImage.astro';
import papers from '../../data/papers.json';
import '../../styles/research.css';

const topics = papers.filter((paper, index) => papers.findIndex(item => item.topic === paper.topic) === index);
---
<SiteLayout title="Research" description="How work gets organized when AI agents act in firms, in new ventures, and between organizations. Research questions, methods, and selected publications." active="research" bodyClass="research-page">
  <nav class="page-nav" aria-label="Back to home"><a href="/"><Arrow /> Home</a></nav>
  <h1>Research</h1>
  <p class="lede">I study how work gets organized when AI agents act in firms, in new ventures, and between organizations.</p>
  <p>The agentic enterprise: How can employees and AI agents divide work by design, not by accident? Related work examines <a href="#renewal">legacy enterprise systems</a>, <a href="#enterprise-ai">human–AI work</a>, and the transition <a href="#pilot-production">from pilot to production</a>.</p>
  <p>AI-native venturing: How can founders build ventures with AI while developing their own judgment? Related work studies <a href="#entrepreneurship">entrepreneurial coaching</a> and <a href="#startup-agency">human–AI agency in startups</a>.</p>
  <p>Agentic ecosystems: How can AI agents act across firms while each firm keeps control? Related work examines <a href="#data-ecosystems">data sharing</a>, <a href="#enterprise-ai">hybrid intelligent service ecosystems</a>, and the coordination needed for <a href="#circular-industry">circular industry</a> and <a href="#circular-value">value constellations</a>.</p>
  <nav class="research-contents" aria-label="Research topics">
    {topics.map(paper => <a href={`#${paper.id}`}>{paper.topic}</a>)}
  </nav>
  {papers.map(paper => (
    <section class="research-stream" id={paper.id} aria-labelledby={`${paper.id}-title`}>
      <h2 id={`${paper.id}-title`}>{paper.question}</h2>
      <div class:list={['stream-body', { 'without-preview': !('image' in paper && paper.image) }]}>
        <div class="stream-idea">
          <p>{paper.idea}</p>
          <a class="idea-link text-link" href={`/research/${paper.slug}/`} aria-label={`Explore the idea: ${paper.question}`}>Explore the idea <Arrow /></a>
        </div>
        {'image' in paper && paper.image && <a class="paper-sheet" href={paper.url} aria-label={`Read ${paper.title}`}>
          <PaperImage file={paper.image} alt={`First page of ${paper.title}`} sizes="(max-width: 380px) 64px, (max-width: 850px) 88px, (max-width: 1150px) 160px, (max-width: 1500px) 230px, 310px" />
        </a>}
        <div class="paper-citation">
          <h3><a href={paper.url}>{paper.title}</a></h3>
          <p class="authors">{paper.authors}</p>
          <p class="venue">{paper.venue}</p>
          {'image_source' in paper && paper.image_source && <p class="paper-source"><a href={paper.image_source.url}>{paper.image_source.label}</a><br />{paper.image_source.credit}</p>}
        </div>
      </div>
    </section>
  ))}
  <section class="research-approach" aria-labelledby="approach-title">
    <h2 id="approach-title">Research in practice</h2>
    <p>Observe: I use qualitative research, including interviews, case studies, and taxonomies, alongside computationally intensive theory construction to generate hypotheses. Build: I use design science to develop AI-based interventions and deploy them in organizations and ventures. Test: I evaluate these interventions through field experiments and interviews.</p>
    <a class="all-publications text-link" href="https://scholar.google.com/citations?user=GqGdTtQAAAAJ&hl=en">All publications on Google Scholar <Arrow /></a>
    <p><a class="text-link" href="/ideas/">Ideas I’m exploring next <Arrow /></a></p>
  </section>
  <footer><span>Daniel Heinz · Karlsruhe</span><a href="/impressum/">Impressum</a><a href="/privacy/">Privacy</a><a href="#content">Back to top <Arrow /></a></footer>
</SiteLayout>
