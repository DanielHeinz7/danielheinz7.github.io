---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import SiteFooter from '../components/SiteFooter.astro';
import profile from '../data/profile.json';
import ResearchProjects from '../components/ResearchProjects.astro';
import '../styles/glance.css';
---
<SiteLayout title="At a glance" description="Daniel Heinz’s research agenda, academic background, teaching, advising, and service." active="at-a-glance" bodyClass="glance-page">
  <nav class="page-nav" aria-label="Back to home"><a href="/"><Arrow /> Home</a></nav>
  <h1>At a glance</h1>
  <p class="lede">{profile.agenda}</p>
  <div class="cv-options"><a class="text-link" href="/cv/">Full CV <Arrow /></a><a href="/files/daniel-heinz-cv.pdf">Download PDF</a></div>

  <section class="glance-section">
    <h2>Research approach</h2>
    <p>{profile.approach}</p>
    <a class="text-link" href="/research/">Questions and publications <Arrow /></a>
  </section>

  <section class="glance-section">
    <h2>Academic background</h2>
    <dl class="academic-record">
      {profile.appointments.map(item => <div><dt>{item.date}</dt><dd><strong>{item.title}</strong><span>{item.place}</span></dd></div>)}
      {profile.education.map(item => <div><dt>{item.date}</dt><dd><strong>{item.title}</strong><span>{item.place}</span>{item.note && <span>{item.note}</span>}</dd></div>)}
    </dl>
    <p>{profile.visits}</p>
    <a class="text-link" href={profile.profileUrl}>Institutional profile <Arrow /></a>
  </section>

  <section class="glance-section">
    <h2>Teaching and advising</h2>
    <p>I teach digital services at master’s level and in executive education, and develop courses that connect research methods with building and evaluating systems.</p>
    <p>{profile.advising}</p>
    <a class="text-link" href="/teaching/">Teaching <Arrow /></a>
  </section>

  <section class="glance-section" id="funded-projects">
    <h2>Selected funded projects</h2>
    <p>{profile.funding}</p>
    <ResearchProjects />
  </section>

  <section class="glance-section">
    <h2>Academic service</h2>
    <ul class="service-list">{profile.service.map(item => <li>{item}</li>)}</ul>
    <p>I also review research for information systems journals and conferences.</p>
    <a class="text-link" href="https://communities.aisnet.org/sigservices-thrive/home">AIS SIG Services <Arrow /></a>
  </section>
  <section class="glance-section">
    <h2>Outside work</h2>
    <p>{profile.outsideWork}</p>
  </section>
  <SiteFooter />
</SiteLayout>
