---
import SiteLayout from '../layouts/SiteLayout.astro';
import Arrow from '../components/Arrow.astro';
import SiteFooter from '../components/SiteFooter.astro';
import '../styles/lab-teaching.css';

const courses = [
  {
    id: 'building-with-ai',
    shortTitle: 'Building with AI',
    title: 'Building Digital Services with AI',
    context: 'Practical seminar · KIT · Winter 2026/27',
    description: 'Take an idea you care about and turn it into a web app with AI coding tools. You keep the app and its repository, so the project can continue beyond the course.',
    parts: [
      {
        label: 'Find your starting point',
        description: 'Choose a problem worth solving. Use early evidence to understand who needs help and give your AI coding tools a clear brief.',
      },
      {
        label: 'Shape the experience',
        description: 'Sketch how people will use your app and bring the main screens to life. Try each other’s prototypes to find what feels intuitive and what needs another pass.',
      },
      {
        label: 'Build a working app',
        description: 'Work with AI coding agents to connect your interface to a database, add login and access controls, and put the app online. Learn to read and debug the code behind your idea.',
      },
      {
        label: 'Make it ready to share',
        description: 'Test the paths that matter and refine your app before the live demo. Your build log captures the decisions and discoveries you can draw on in your next project.',
      },
    ],
    href: 'https://dsi.win.kit.edu/courses_1335.php',
    linkLabel: 'Course details',
  },
  {
    id: 'digital-services',
    shortTitle: 'Digital services',
    title: 'Digital Services: Innovation & Business Models',
    context: 'Master’s course · KIT',
    description: 'What makes a digital service worth adopting? In this co-taught course, I explore that question through innovation adoption, platforms, and smart services. Prepare the concepts before class, then put them to work in cases we discuss together.',
    parts: [
      {
        label: 'Innovation adoption',
        description: 'Follow an idea from its first users to wider adoption. Work out why people embrace a new service, what holds them back, and how to make the change worthwhile.',
      },
      {
        label: 'Platforms and ecosystems',
        description: 'Step into the Apple–Epic dispute to explore who creates value and who sets the rules. Use network effects and platform governance to make sense of the competing interests.',
      },
      {
        label: 'Smart services',
        description: 'Imagine what a connected product could do for its users beyond the initial sale. Explore how sensors and data support new services, and what it takes to bring those services into use.',
      },
    ],
    href: 'https://dsi.win.kit.edu/courses_1204.php',
    linkLabel: 'Course details',
  },
  {
    id: 'doctoral-seminar',
    shortTitle: 'Philosophy of science',
    title: 'Philosophy of Science',
    context: 'Doctoral seminar · KIT · Winter 2026/27',
    description: 'What do we really learn when we do research? I co-lead this seminar as a space to explore that question together. Bring your own project into conversation with foundational readings and other researchers’ perspectives.',
    parts: [
      {
        label: 'See your question differently',
        description: 'Try looking at your research question through another philosophical lens. Discover how a different starting point changes the evidence you seek and the answers you might find.',
      },
      {
        label: 'Find the contribution',
        description: 'Put into words what your research could help us understand. Discuss the role of technology in your work and who might find your insights useful beyond academia.',
      },
      {
        label: 'Shape your research practice',
        description: 'Articulate the kind of researcher you want to be. Explore where AI could help your work and which decisions you want to think through yourself.',
      },
    ],
  },
  {
    id: 'executive-education',
    shortTitle: 'Executive education',
    title: 'Digital Services at HECTOR School',
    context: 'Executive education · KIT',
    description: 'Where could digital services take your organization next? My HECTOR School sessions give professionals concepts and cases to explore new offerings and the choices involved in making them work.',
    parts: [
      {
        label: 'Innovation adoption',
        description: 'Explore how a promising service wins support inside a company and earns a place in customers’ lives. Cases help you think through the people and changes that make adoption possible.',
      },
      {
        label: 'Platforms and ecosystems',
        description: 'Map where a company could contribute to a platform ecosystem and how it depends on others. Discuss the choices around openness, partnerships, and who captures the value.',
      },
      {
        label: 'Smart services',
        description: 'Explore service opportunities around connected products, from remote support to predictive maintenance. Connect what the technology makes possible with a useful offering and a workable business model.',
      },
      {
        label: 'Sustainable digital services',
        description: 'Consider how services could keep products useful for longer. Explore how shared data and digital product passports can help companies work together on circular business models.',
      },
    ],
    href: 'https://www.hectorschool.kit.edu/specialization-digital-services.php',
    linkLabel: 'Program details',
  },
];
---

<SiteLayout
  title="Teaching"
  description="Daniel Heinz’s teaching in digital services, AI-assisted development, philosophy of science, and executive education at KIT."
  active="teaching"
  bodyClass="lab-teaching-page"
>
  <nav class="page-nav" aria-label="Back to home">
    <a href="/"><Arrow /> Home</a>
  </nav>

  <h1>Teaching</h1>
  <p class="lede">From building your own digital service to finding your voice as a researcher.</p>

  <nav class="research-contents" aria-label="Courses on this page">
    {courses.map(course => <a href={`#${course.id}`}>{course.shortTitle}</a>)}
  </nav>

  <div class="course-list">
    {courses.map((course) => (
      <section class="course-entry" id={course.id} aria-labelledby={`${course.id}-title`}>
        <h2 id={`${course.id}-title`}>{course.title}</h2>
        <p class="course-context">{course.context}</p>
        <p>{course.description}</p>
        <dl class="course-parts">
          {course.parts.map(part => (
            <div>
              <dt>{part.label}</dt>
              <dd>{part.description}</dd>
            </div>
          ))}
        </dl>
        {course.href && (
          <a class="text-link section-link" href={course.href} aria-label={`${course.linkLabel}: ${course.title}`}>
            {course.linkLabel} <Arrow />
          </a>
        )}
      </section>
    ))}
  </div>

  <section class="field-section" aria-labelledby="advising-title">
    <h2 id="advising-title">Research through a thesis</h2>
    <p>A thesis gives you room to pursue a question of your own. I advise doctoral researchers and bachelor’s and master’s students on how to turn that curiosity into a study.</p>
    <a class="text-link section-link" href="https://dsi.win.kit.edu/theses.php">Thesis opportunities at KIT <Arrow /></a>
  </section>

  <nav class="related-pages" aria-label="Continue exploring">
    <a class="text-link" href="/lab/">Lab <Arrow /></a>
    <a class="text-link" href="/research/">Research <Arrow /></a>
  </nav>
  <SiteFooter />
</SiteLayout>
