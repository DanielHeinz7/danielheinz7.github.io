---
import SiteLayout from '../../layouts/SiteLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Arrow from '../../components/Arrow.astro';
import ideas from '../../data/ideas.json';
---

<SiteLayout title="Ideas" description="Open questions about entrepreneurship with AI, human judgment, and how people and organizations work with agents." active="ideas">
  <nav class="page-nav" aria-label="Back to home"><a href="/"><Arrow /> Home</a></nav>
  <PageHeader title="Ideas" intro="Questions I’m working through." />
  <nav class="ideas-contents" aria-label="Ideas on this page">
    {ideas.map(idea => <a href={`#${idea.id}`}>{idea.label}</a>)}
  </nav>
  <div class="idea-notes">
    {ideas.map(idea => (
      <article class="idea-note" id={idea.id} aria-labelledby={`${idea.id}-title`}>
        <h2 id={`${idea.id}-title`}>{idea.title}</h2>
        {idea.paragraphs.map(paragraph => <p>{paragraph}</p>)}
        <p class="open-question">{idea.question}</p>
        {'related' in idea && idea.related && <p><a class="text-link" href={idea.related.href}>{idea.related.label} <Arrow /></a></p>}
      </article>
    ))}
  </div>
  <p class="research-return"><a class="text-link" href="/research/">Explore the published research <Arrow /></a></p>
  <footer><span>Daniel Heinz · Karlsruhe</span><a href="/impressum/">Impressum</a><a href="/privacy/">Privacy</a><a href="#content">Back to top <Arrow /></a></footer>
</SiteLayout>

<style>
  .ideas-contents { display: flex; flex-wrap: wrap; gap: 0 24px; margin-top: 24px; padding-bottom: 16px; border-bottom: 1px solid var(--rule); }
  .ideas-contents a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; }
  .idea-notes { max-width: 65ch; }
  .idea-note { margin-top: 36px; padding-bottom: 36px; border-bottom: 1px solid var(--rule); }
  .idea-note h2 { max-width: 35ch; text-wrap: balance; }
  .idea-note p { margin-top: 16px; }
  .idea-note .open-question { margin-top: 24px; font-size: 20px; line-height: 1.5; }
  .research-return { margin-top: 32px; }
  @media (max-width: 850px) {
    .idea-note { margin-top: 28px; padding-bottom: 28px; }
    .ideas-contents { column-gap: 20px; }
  }
</style>
