---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ResearchProjects from '../components/ResearchProjects.astro';
import profile from '../data/profile.json';
import publications from '../data/cv-publications.json';
import researchers from '../data/doctoral-research.json';
import '../styles/glance.css';

interface Publication {
  venue: string; year: number; status: string;
  volume?: string | null; issue?: string | null; pages?: string | null; article_number?: string | null;
}
function citation(paper: Publication) {
  let text = paper.venue;
  if (paper.volume) text += ` ${paper.volume}${paper.issue ? `(${paper.issue})` : ''}`;
  if (paper.pages) text += `, ${paper.pages}`;
  else if (paper.article_number) text += `, Article ${paper.article_number}`;
  text += ` · ${paper.year}`;
  if (paper.status !== 'published') text += ` · ${paper.status[0].toUpperCase()}${paper.status.slice(1)}`;
  return text;
}
const publicationSections = [
  { id: 'journal-articles', title: 'Journal articles', papers: publications.journal_articles },
  { id: 'conference-papers', title: 'Selected conference papers', papers: publications.selected_conference_papers },
];
---
<SiteLayout title="Curriculum vitae" description="Daniel Heinz’s academic background, publications, funded projects, teaching, advising, and academic service." active="at-a-glance" bodyClass="glance-page cv-page">
  <h1>Curriculum vitae</h1>
  <p class="lede">{profile.name}<br />{profile.role}<br />{profile.institution}</p>
  <div class="cv-options"><a class="text-link" href="/files/daniel-heinz-cv.pdf">Download CV (PDF)</a><span>Updated {profile.updated}</span></div>
  <nav class="research-contents" aria-label="CV sections">
    <a href="#background">Background</a><a href="#funded-projects">Projects</a><a href="#journal-articles">Journal articles</a><a href="#conference-papers">Conference papers</a><a href="#teaching">Teaching</a><a href="#service">Service</a>
  </nav>
  <section class="glance-section" aria-labelledby="agenda-title">
    <h2 id="agenda-title">Research</h2><p>{profile.agenda}</p><p>{profile.approach}</p>
  </section>
  <section class="glance-section" id="background" aria-labelledby="background-title">
    <h2 id="background-title">Academic appointments and education</h2>
    <dl class="academic-record">
      {[...profile.appointments, ...profile.education].map(item => <div><dt>{item.date}</dt><dd><strong>{item.title}</strong><span>{item.place}</span>{'note' in item && item.note && <span>{item.note}</span>}</dd></div>)}
    </dl>
    <p>{profile.visits}</p>
  </section>
  <section class="glance-section" id="funded-projects" aria-labelledby="projects-title">
    <h2 id="projects-title">Selected funded projects</h2><p>{profile.funding}</p><ResearchProjects />
  </section>
  {publicationSections.map(group => (
    <section class="glance-section" id={group.id} aria-labelledby={`${group.id}-title`}>
      <h2 id={`${group.id}-title`}>{group.title}</h2>
      <ul class="cv-publications">
        {group.papers.map(paper => <li><h3><a href={paper.url}>{paper.title}</a></h3><p>{paper.full_authors}</p><p class="citation">{citation(paper)}</p></li>)}
      </ul>
    </section>
  ))}
  <section class="glance-section" id="teaching" aria-labelledby="teaching-title">
    <h2 id="teaching-title">Teaching and advising</h2>
    <ul class="cv-teaching">{profile.teaching.map(course => <li><strong>{course.title}</strong><span>{course.context}</span></li>)}</ul>
    <p>{profile.advising}</p>
    <h3 class="doctoral-heading">Doctoral research</h3>
    <p>I provide day-to-day research advising. Prof. Gerhard Satzger provides formal doctoral supervision for the projects below.</p>
    <ul class="cv-teaching">{researchers.map(person => <li><strong><a href={person.url}>{person.name}</a></strong> · {person.since}<span>{person.topic}</span></li>)}</ul>
    <p><a href="/lab/#doctoral-title">Doctoral research in the lab</a> · <a href="/teaching/">Course details</a></p>
  </section>
  <section class="glance-section" id="service" aria-labelledby="service-title">
    <h2 id="service-title">Academic service</h2><ul class="service-list">{profile.service.map(item => <li>{item}</li>)}</ul>
  </section>
  <section class="glance-section" aria-labelledby="volunteering-title">
    <h2 id="volunteering-title">Volunteering</h2><p>{profile.outsideWork}</p>
  </section>
  <p class="return-link"><a href={`mailto:${profile.email}`}>{profile.email}</a> · <a href={profile.profileUrl}>Institutional profile</a></p>
  <SiteFooter />
</SiteLayout>

<style>
  .cv-publications { list-style: none; padding: 0; margin: 24px 0 0; max-width: 65ch; }
  .cv-publications li + li { margin-top: 28px; }
  .cv-publications h3 { font-size: 16px; }
  .cv-publications p { margin-top: 8px; }
  .citation, .cv-options span { color: var(--mute); }
  .cv-teaching { padding-left: 20px; margin-top: 20px; }
  .cv-teaching li + li { margin-top: 16px; }
  .cv-teaching span { display: block; }
  .doctoral-heading { margin-top: 28px; font-size: 16px; }
  @media print {
    :global(.cv-page .cover), :global(.cv-page .skip), .cv-options, .research-contents, :global(.cv-page footer) { display: none; }
    :global(.cv-page .spread) { display: block; }
    :global(.cv-page .page-column) { padding: 0; }
    :global(.cv-page h2), :global(.cv-page h3) { break-after: avoid; }
    .cv-publications li, .cv-teaching li { break-inside: avoid; }
  }
</style>
