---
import SiteLayout from '../layouts/SiteLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Arrow from '../components/Arrow.astro';
import { navigation } from '../data/site';
---
<SiteLayout title="Page not found" bodyClass="compact-navigation">
  <PageHeader title="That page isn't here." intro="The link may have changed. You can return home or explore the site below." />
  <p class="return-link"><a class="text-link" href="/">Go to the homepage <Arrow /></a></p>
  <nav class="tiles" aria-label="Explore the site">
    {navigation.map(({ href, label }) => <a class="tile" href={href}><span class="tile-title">{label}<Arrow /></span></a>)}
  </nav>
</SiteLayout>
